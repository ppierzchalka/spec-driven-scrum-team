{
  "name": "spec-driven-scrum-team",
  "version": "0.1.0",
  "description": "Installer + autonomous-implement pipeline for a seven-agent scrum team on opencode",
  "type": "module",
  "private": true,
  "bin": {
    "install-team": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "yaml": "^2.9.1"
  }
}
