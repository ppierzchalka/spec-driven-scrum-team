{
  "name": "spec-driven-scrum-team",
  "version": "0.1.0",
  "description": "Installer + product planning and skill-based procedures and configurable eight-agent execution with selected harness adapters",
  "type": "module",
  "private": true,
  "bin": {
    "install-team": "./dist/cli/launch.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/stamp-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --project fast",
    "test:rendered": "vitest run --project rendered",
    "test:release": "vitest run --project release",
    "test:watch": "vitest",
    "setup": "tsx src/cli.ts",
    "pack": "npm run build && npm pack --dry-run"
  },
  "files": [
    "dist/**/*",
    "agents/**/*",
    "skills/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.0",
    "smol-toml": "^1.9.0",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
